PORT=5000
NODE_ENV=development

# Database Connection (MySQL via Prisma)
# Portability Notice: Standard MySQL connection string format.
# Replace with your Aiven connection string for dev or domainz.in cPanel MySQL for production.
# The only value that changes between environments is this connection string.
DATABASE_URL="mysql://user:password@host:port/database?ssl-mode=REQUIRED"

# Security & Auth Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ────────────────────────────────────────────────────────────
# 1. CANTEEN RAZORPAY ACCOUNT (Student Meal Checkout ONLY)
# Used for student menu item purchasing. Never touch for subscription.
# ────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_YourCanteenKeyIdHere
RAZORPAY_KEY_SECRET=YourCanteenKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourCanteenWebhookSecretHere

# ────────────────────────────────────────────────────────────
# 2. DEVELOPER RAZORPAY ACCOUNT (Canteen Subscription Billing ONLY)
# Used for recurring canteen super_admin subscription payments to Developer.
# ────────────────────────────────────────────────────────────
DEV_RAZORPAY_KEY_ID=rzp_test_DevSubscriptionKeyIdHere
DEV_RAZORPAY_KEY_SECRET=DevSubscriptionKeySecretHere
DEV_RAZORPAY_WEBHOOK_SECRET=DevSubscriptionWebhookSecretHere

# Nodemailer / Email Service for OTP & Admin Setup Links
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Mess Management System" <no-reply@messapp.com>

# CORS Settings
FRONTEND_STUDENT_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Order History Retention Policy (in days)
ORDER_RETENTION_DAYS=60
