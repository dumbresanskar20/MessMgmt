// Prisma schema for Mess Management System
// Database: MySQL (provider: mysql)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum AdminRole {
  super_admin
  staff
}

enum MealType {
  breakfast
  lunch
  snacks
  dinner
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum PaymentMethod {
  razorpay
  counter_cash
  counter_upi
  other
}

enum OrderStatus {
  placed
  preparing
  ready
  delivered
  cancelled
}

enum PlanType {
  monthly
  quarterly
  six_month
  yearly
}

enum SubscriptionStatus {
  active
  expired
  suspended
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model Student {
  id                    Int       @id @default(autoincrement())
  name                  String
  email                 String    @unique
  roll_no               String    @unique
  password_hash         String
  is_verified           Boolean   @default(false)
  otp_code              String?
  otp_expires_at        DateTime?
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?
  reset_token           String?
  reset_token_expires   DateTime?
  created_at            DateTime  @default(now())

  orders Order[]

  @@map("Student")
}

model AdminUser {
  id                 Int        @id @default(autoincrement())
  username           String     @unique
  email              String     @unique
  password_hash      String
  role               AdminRole  @default(staff)
  is_active          Boolean    @default(true)
  is_verified        Boolean    @default(false)
  verification_token String?
  created_by_id      Int?
  last_login_at      DateTime?
  created_at         DateTime   @default(now())

  creator      AdminUser?  @relation("AdminCreatedBy", fields: [created_by_id], references: [id])
  created_staff AdminUser[] @relation("AdminCreatedBy")

  @@map("AdminUser")
}

model MenuItem {
  id                   Int      @id @default(autoincrement())
  name                 String
  image_url            String   @default("https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=600&q=80")
  cloudinary_public_id String?
  meal_type            MealType
  price                Decimal  @db.Decimal(10, 2)
  is_active            Boolean  @default(true)
  description          String?  @default("")
  created_at           DateTime @default(now())

  order_items OrderItem[]

  @@index([meal_type, is_active])
  @@map("MenuItem")
}

model MealWindow {
  id         Int      @id @default(autoincrement())
  meal_type  MealType @unique
  is_active  Boolean  @default(true)
  is_full_day Boolean  @default(false)
  start_time String   @default("08:00")
  end_time   String   @default("20:00")
  created_at DateTime @default(now())

  @@map("MealWindow")
}

model Order {
  id                 Int            @id @default(autoincrement())
  student_id         Int
  meal_type          MealType
  total_amount       Decimal        @db.Decimal(10, 2)
  payment_status     PaymentStatus  @default(pending)
  payment_method     PaymentMethod?
  razorpay_order_id  String?
  razorpay_payment_id String?
  razorpay_signature String?
  token_number       String?
  daily_sequence     Int            @default(0)
  order_status       OrderStatus    @default(placed)
  date               String         // YYYY-MM-DD
  created_at         DateTime       @default(now())

  student Student     @relation(fields: [student_id], references: [id])
  items   OrderItem[]

  @@index([student_id, date])
  @@index([date, meal_type, payment_status])
  @@index([order_status])
  @@map("Order")
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  order_id     Int
  menu_item_id Int?
  item_name    String
  price        Decimal @db.Decimal(10, 2)
  quantity     Int

  order     Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  menu_item MenuItem? @relation(fields: [menu_item_id], references: [id], onDelete: SetNull)

  @@map("OrderItem")
}

// Used for atomic sequential token number generation per meal type per day
model DailyTokenCounter {
  id                Int    @id @default(autoincrement())
  meal_type         String
  date              String // YYYY-MM-DD
  last_token_number Int    @default(0)

  @@unique([meal_type, date], name: "meal_type_date")
  @@map("DailyTokenCounter")
}

model Subscription {
  id                      Int                @id @default(autoincrement())
  plan_type               PlanType
  subscription_start_date DateTime
  subscription_end_date   DateTime
  status                  SubscriptionStatus @default(active)
  last_payment_amount     Decimal?           @db.Decimal(10, 2)
  last_payment_date       DateTime?
  dev_razorpay_payment_id  String?
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt

  @@map("Subscription")
}
