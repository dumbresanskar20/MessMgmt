PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas cluster connection string)
ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/mess_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mess_management

# Security & Auth Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Credentials (Test mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Nodemailer / Email Service for OTP & Admin Setup Links
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Mess Management System" <no-reply@messapp.com>

# CORS Settings
FRONTEND_STUDENT_URL=http://localhost:5173
FRONTEND_ADMIN_URL=http://localhost:5174

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Order History Retention Policy (in days)
ORDER_RETENTION_DAYS=60


